    "    cols['BankruptcyHistory'] = df['BankruptcyHistory'].to_numpy(float)\n",
    "    cols['PreviousLoanDefaults'] = df['PreviousLoanDefaults'].to_numpy(float)\n",
    "    cols['Employed'] = (df['EmploymentStatus'] == 'Employed').to_numpy(float)\n",
    "    return pd.DataFrame(cols, index=df.index)\n",
    "\n",
    "\n",
    "def band_features(df, age_knots=(30, 40, 50, 60)):\n",
    "    d = df[BAND_COLUMNS].astype(float).copy()\n",
    "    d['Unemployed'] = (df['EmploymentStatus'] == 'Unemployed').astype(float)\n",
    "    d['OwnOrMortgage'] = df['HomeOwnershipStatus'].isin(['Own', 'Mortgage']).astype(float)\n",
    "    for level in ['Associate', 'Bachelor', 'Master', 'Doctorate']:\n",
    "        d['Education=' + level] = (df['EducationLevel'] == level).astype(float)\n",
    "    for knot in age_knots:\n",
    "        d[f'Age>{knot}'] = np.maximum(df['Age'].astype(float) - knot, 0.0)\n",
    "    return d\n",
    "\n",
    "\n",
    "class ScorecardMixtureRegression:\n",
    "    def __init__(self, near_iters=4, age_knots=(30, 40, 50, 60), kappa0=0.36, max_em_iter=25, lam_index=1e-3):\n",
    "        self.near_iters = near_iters\n",
    "        self.age_knots = age_knots\n",
    "        self.kappa0 = kappa0\n",
    "        self.max_em_iter = max_em_iter\n",
    "        self.lam_index = lam_index\n",
    "\n",
    "    def _fit_score(self, A, y):\n",
    "        kappa, labels = self.kappa0, None\n",
    "        ols = LinearRegression(method='analytic', fit_intercept=False)\n",
    "        w = ols.fit(A, y / (1.0 + kappa * (y > np.median(y)))).coef_\n",
    "        for _ in range(self.max_em_iter):\n",
    "            S = A @ w\n",
    "            new_labels = (np.abs(y - S * (1.0 + kappa)) < np.abs(y - S)).astype(float)\n",
    "            if labels is not None and (new_labels == labels).all():\n",
    "                break\n",
    "            labels = new_labels\n",
    "            for _ in range(3):\n",
    "                w = ols.fit(A * (1.0 + kappa * labels)[:, None], y).coef_\n",
    "                S = A @ w\n",
    "                kappa = LinearRegression(method='analytic', fit_intercept=False).fit((labels * S)[:, None], y - S).coef_[0]\n",
    "        return w, kappa, labels\n",
    "\n",
    "    def _fit_index(self, X, r):\n",
    "        fit_fn = lambda Xp, rp: LinearRegression(method='analytic', penalty='l2', lam=self.lam_index).fit(Xp, rp)\n",
    "        model = fit_fn(X, r)\n",
    "        for _ in range(self.near_iters):\n",
    "            u = model.predict(X)\n",
    "            near = (u > 0.1) & (u < 0.9)\n",
    "            model = fit_fn(X[near], r[near])\n",
    "        return model\n",
    "\n",
    "    def _fit_score_soft(self, A, y, X, w, kappa, labels, n_rounds=4, n_steps=10):\n",
    "        ols = LinearRegression(method='analytic', fit_intercept=False)\n",
    "        sigma2 = np.mean((y - (A @ w) * (1.0 + kappa * labels)) ** 2)\n",
    "        prior = np.full(len(y), 0.5)\n",
    "        for _ in range(n_rounds):\n",
    "            for _ in range(n_steps):\n",
    "                S = A @ w\n",
    "                log_ratio = ((y - S) ** 2 - (y - S * (1.0 + kappa)) ** 2) / (2.0 * sigma2)\n",
    "                r = prior / (prior + (1.0 - prior) * np.exp(-np.clip(log_ratio, -500.0, 500.0)))\n",
    "                root_r, root_q = np.sqrt(r)[:, None], np.sqrt(1.0 - r)[:, None]\n",
    "                design = np.vstack([A * (1.0 + kappa) * root_r, A * root_q])\n",
    "                target = np.concatenate([y * root_r[:, 0], y * root_q[:, 0]])\n",
    "                w = ols.fit(design, target).coef_\n",
    "                S = A @ w\n",
    "                kappa = np.sum(r * S * (y - S)) / np.sum(r * S * S)\n",
    "                sigma2 = np.mean(r * (y - S * (1.0 + kappa)) ** 2 + (1.0 - r) * (y - S) ** 2)\n",
    "            prior = np.clip(self._fit_index(X, r).predict(X), 1e-3, 1.0 - 1e-3)\n",
    "        return w, kappa, r\n",
    "\n",
    "    def fit(self, df, y):\n",
    "        y = np.asarray(y, dtype=float)\n",
    "        A = np.column_stack([np.ones(len(y)), scorecard_features(df).to_numpy()])\n",
    "        self.band_scaler_ = ZScoreScaler()\n",
    "        X = self.band_scaler_.fit_transform(band_features(df, self.age_knots).to_numpy())\n",
    "        self.w_, self.kappa_, self.labels_ = self._fit_score(A, y)\n",
    "        self.w_, self.kappa_, self.responsibilities_ = self._fit_score_soft(A, y, X, self.w_, self.kappa_, self.labels_)\n",
    "        self.labels_ = (self.responsibilities_ > 0.5).astype(float)\n",
    "        self.index_ = self._fit_index(X, self.responsibilities_)\n",
    "        return self\n",
    "\n",
    "    def score(self, df):\n",
    "        return np.column_stack([np.ones(len(df)), scorecard_features(df).to_numpy()]) @ self.w_\n",
    "\n",
    "    def band_probability(self, df):\n",
    "        X = self.band_scaler_.transform(band_features(df, self.age_knots).to_numpy())\n",
    "        return np.clip(self.index_.predict(X), 0.0, 1.0)\n",
    "\n",
    "    def predict(self, df):\n",
    "        return self.score(df) * (1.0 + self.kappa_ * self.band_probability(df))"
   ]
  },
