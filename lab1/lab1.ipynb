    "class BaselineEncoder:\n",
    "    \"\"\"Числовые столбцы и категории, известные только обучающей части.\"\"\"\n",
    "    def fit(self,frame):\n",
    "        self.numeric_columns_ = list(NUM_COLS)\n",
    "        self.categories_ = {c:sorted(frame[c].astype(str).unique()) for c in CAT_COLS}\n",
    "        return self\n",
    "\n",
    "    def transform(self,frame):\n",
    "        blocks = [frame[self.numeric_columns_].to_numpy(float)]\n",
    "        for column,levels in self.categories_.items():\n",
    "            values = frame[column].astype(str).to_numpy()\n",
    "            blocks.extend((values==level).astype(float)[:,None] for level in levels[1:])\n",
    "        return np.column_stack(blocks)\n",
    "\n",
    "\n",
    "tr_idx, va_idx = split_indices(len(y_all), test_size=0.2, seed=SEED)\n",
    "base_encoder = BaselineEncoder().fit(train.iloc[tr_idx])\n",
    "X_base_raw = base_encoder.transform(train)\n",
    "scaler_base = ZScoreScaler().fit(X_base_raw[tr_idx])\n",
    "X_tr, X_va = scaler_base.transform(X_base_raw[tr_idx]), scaler_base.transform(X_base_raw[va_idx])\n",
    "y_tr, y_va = y_all[tr_idx], y_all[va_idx]\n",
    "\n",
    "rank_X = np.linalg.matrix_rank(X_tr)\n",
    "print(f'Размер X_tr: {X_tr.shape}, ранг матрицы: {rank_X} (есть линейно зависимые столбцы: {rank_X < X_tr.shape[1]})')\n",
    "\n",
    "sk_lr = SkLinearRegression().fit(X_tr, y_tr)\n",
    "sk_pred = sk_lr.predict(X_va)\n",
    "\n",
    "m_an = LinearRegression(method='analytic').fit(X_tr, y_tr)\n",
    "m_gd = LinearRegression(method='gd', lr=0.1, n_iter=50000, tol=1e-12).fit(X_tr, y_tr)\n",
    "m_sgd = LinearRegression(method='sgd', lr=0.01, n_iter=20, batch_size=1, tol=1e-6, seed=SEED).fit(X_tr, y_tr)\n",
    "sk_sgd = SkSGDRegressor(loss='squared_error', penalty=None, fit_intercept=True, max_iter=1000, tol=1e-4, random_state=SEED).fit(X_tr, y_tr)\n",
    "\n",
    "rows = []\n",
    "for name, model in [\n",
    "    ('sklearn LinearRegression', sk_lr),\n",
