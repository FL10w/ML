    "def _check_1d_pair(y_true, y_pred):\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    y_pred = np.asarray(y_pred, dtype=float)\n",
    "    if y_true.ndim != 1 or y_pred.ndim != 1 or y_true.shape != y_pred.shape:\n",
    "        raise ValueError(f'Ожидались одномерные массивы одинаковой длины, получено {y_true.shape} и {y_pred.shape}')\n",
    "    if len(y_true)==0 or not (np.isfinite(y_true).all() and np.isfinite(y_pred).all()):\n",
    "        raise ValueError('Нужны непустые конечные массивы')\n",
    "    return y_true, y_pred\n",
    "\n",
    "\n",
    "def mse(y_true, y_pred):\n",
    "    y_true, y_pred = _check_1d_pair(y_true, y_pred)\n",
    "    return float(np.mean((y_true - y_pred) ** 2))\n",
    "\n",
    "\n",
    "def mae(y_true, y_pred):\n",
    "    y_true, y_pred = _check_1d_pair(y_true, y_pred)\n",
    "    return float(np.mean(np.abs(y_true - y_pred)))\n",
    "\n",
    "\n",
    "def r2(y_true, y_pred):\n",
    "    y_true, y_pred = _check_1d_pair(y_true, y_pred)\n",
    "    if len(y_true) < 2:\n",
    "        return float('nan')\n",
    "    ss_res = np.sum((y_true - y_pred) ** 2)\n",
    "    ss_tot = np.sum((y_true - y_true.mean()) ** 2)\n",
    "    if ss_tot == 0.0:\n",
    "        return 1.0 if ss_res == 0.0 else 0.0\n",
    "    return float(1.0 - ss_res / ss_tot)\n",
    "\n",
    "\n",
    "def mape(y_true, y_pred):\n",
    "    y_true, y_pred = _check_1d_pair(y_true, y_pred)\n",
    "    eps = np.finfo(float).eps\n",
    "    return float(np.mean(np.abs(y_true - y_pred) / np.maximum(np.abs(y_true), eps)))\n",
    "\n",
    "\n",
    "def all_metrics(y_true, y_pred):\n",
    "    return {\n",
    "        'MSE': mse(y_true, y_pred),\n",
    "        'MAE': mae(y_true, y_pred),\n",
    "        'R2': r2(y_true, y_pred),\n",
    "        'MAPE': mape(y_true, y_pred),\n",
    "    }\n",
    "\n",
    "\n",
    "yt_toy = np.array([2.0, 4.0, 5.0])\n",
    "yp_toy = np.array([2.0, 5.0, 3.0])\n",
    "assert np.isclose(mse(yt_toy, yp_toy), 5.0 / 3.0)\n",
    "assert np.isclose(mae(yt_toy, yp_toy), 1.0)\n",
    "assert np.isclose(r2(yt_toy, yp_toy), -1.0 / 14.0)\n",
    "assert np.isclose(mape(yt_toy, yp_toy), 13.0 / 60.0)\n",
    "\n",
    "rng = np.random.default_rng(SEED)\n",
    "yt = y_all[:500]\n",
    "yp = yt + rng.normal(0, 3.0, size=len(yt))\n",
    "check_metrics = pd.DataFrame({\n",
    "    'Своя': [mse(yt, yp), mae(yt, yp), r2(yt, yp), mape(yt, yp)],\n",
    "    'sklearn': [\n",
    "        mean_squared_error(yt, yp),\n",
    "        mean_absolute_error(yt, yp),\n",
    "        r2_score(yt, yp),\n",
    "        mean_absolute_percentage_error(yt, yp),\n",
    "    ],\n",
    "}, index=['MSE', 'MAE', 'R2', 'MAPE'])\n",
    "check_metrics['Разница'] = np.abs(check_metrics['Своя'] - check_metrics['sklearn'])\n",
    "print(check_metrics.to_string())\n",
    "\n",
    "assert np.isnan(r2([1.0], [1.0]))\n",
    "assert np.isclose(r2([5.0, 5.0, 5.0], [5.0, 5.0, 5.0]), r2_score([5.0, 5.0, 5.0], [5.0, 5.0, 5.0]))\n",
