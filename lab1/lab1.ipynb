    "class LinearRegression:\n",
    "    def __init__(self, method='analytic', lr=0.05, n_iter=400, batch_size=1, tol=1e-6,\n",
    "                 penalty=None, lam=0.0, l1_ratio=0.5, p=2.0, fit_intercept=True, seed=SEED):\n",
    "        self.method = method\n",
    "        self.lr = lr\n",
    "        self.n_iter = n_iter\n",
    "        self.batch_size = batch_size\n",
    "        self.tol = tol\n",
    "        self.penalty = penalty\n",
    "        self.lam = lam\n",
    "        self.l1_ratio = l1_ratio\n",
    "        self.p = p\n",
    "        self.fit_intercept = fit_intercept\n",
    "        self.seed = seed\n",
    "\n",
    "    def _validate_params(self, X, y):\n",
    "        if self.method not in ('analytic', 'gd', 'sgd'):\n",
    "            raise ValueError(f'Неизвестный метод: {self.method}')\n",
    "        if self.penalty not in (None, 'l1', 'l2', 'elasticnet', 'lp'):\n",
    "            raise ValueError(f'Неизвестная регуляризация: {self.penalty}')\n",
    "        if not (isinstance(self.n_iter, (int, np.integer)) and self.n_iter >= 1):\n",
    "            raise ValueError(f'n_iter должен быть целым >= 1, получено {self.n_iter}')\n",
    "        if not (isinstance(self.batch_size, (int, np.integer)) and self.batch_size >= 1):\n",
    "            raise ValueError(f'batch_size должен быть целым >= 1, получено {self.batch_size}')\n",
    "        if self.lr <= 0 or not np.isfinite(self.lr):\n",
    "            raise ValueError(f'lr должен быть конечным и > 0, получено {self.lr}')\n",
    "        if self.tol < 0 or not np.isfinite(self.tol):\n",
    "            raise ValueError(f'tol должен быть >= 0, получено {self.tol}')\n",
    "        if self.lam < 0 or not np.isfinite(self.lam):\n",
    "            raise ValueError(f'lam должен быть >= 0, получено {self.lam}')\n",
    "        if not (0.0 <= self.l1_ratio <= 1.0):\n",
    "            raise ValueError(f'l1_ratio должен быть в [0, 1], получено {self.l1_ratio}')\n",
    "        if self.p <= 0 or not np.isfinite(self.p):\n",
    "            raise ValueError(f'p должен быть > 0, получено {self.p}')\n",
    "        if X.ndim != 2 or y.ndim != 1 or len(X) != len(y) or len(X) == 0:\n",
    "            raise ValueError(f'Некорректные формы X={X.shape}, y={y.shape}')\n",
    "        if not (np.isfinite(X).all() and np.isfinite(y).all()):\n",
    "            raise ValueError('Входные данные X или y содержат NaN или Inf')\n",
    "\n",
    "    def _soft_threshold(self, v, thr):\n",
    "        return np.sign(v) * np.maximum(np.abs(v) - thr, 0.0)\n",
    "\n",
    "    def _penalty_value(self, w):\n",
    "        if not self.penalty or self.lam == 0:\n",
    "            return 0.0\n",
    "        if self.penalty == 'l2':\n",
    "            return 0.5 * self.lam * float(np.sum(w ** 2))\n",
    "        if self.penalty == 'l1':\n",
    "            return self.lam * float(np.sum(np.abs(w)))\n",
    "        if self.penalty == 'elasticnet':\n",
    "            return self.lam * (self.l1_ratio * float(np.sum(np.abs(w))) + 0.5 * (1.0 - self.l1_ratio) * float(np.sum(w ** 2)))\n",
    "        if self.penalty == 'lp':\n",
    "            return self.lam * float(np.sum((w ** 2 + 1e-6) ** (self.p / 2.0)))\n",
    "\n",
    "    def _grad_penalty(self, w):\n",
    "        if not self.penalty or self.lam == 0:\n",
    "            return np.zeros_like(w)\n",
    "        if self.penalty == 'l2':\n",
    "            return self.lam * w\n",
    "        if self.penalty == 'l1':\n",
    "            return self.lam * np.sign(w)\n",
    "        if self.penalty == 'elasticnet':\n",
    "            return self.lam * self.l1_ratio * np.sign(w) + self.lam * (1.0 - self.l1_ratio) * w\n",
    "        if self.penalty == 'lp':\n",
    "            return self.lam * self.p * w * (w ** 2 + 1e-6) ** (self.p / 2.0 - 1.0)\n",
    "\n",
    "    def _fit_coordinate_descent(self, X, y, l1_alpha, l2_alpha):\n",
    "        n, d = X.shape\n",
    "        x_mean = X.mean(axis=0) if self.fit_intercept else np.zeros(d)\n",
    "        y_mean = y.mean() if self.fit_intercept else 0.0\n",
    "        Xc = X - x_mean\n",
    "        yc = y - y_mean\n",
    "        w = np.zeros(d)\n",
    "        col_norm2 = np.sum(Xc ** 2, axis=0)\n",
    "        for _ in range(max(self.n_iter, 2000)):\n",
    "            w_old = w.copy()\n",
    "            r = yc - Xc @ w\n",
    "            for j in range(d):\n",
    "                if col_norm2[j] == 0:\n",
    "                    continue\n",
    "                r += Xc[:, j] * w[j]\n",
    "                rho = Xc[:, j] @ r\n",
    "                w[j] = self._soft_threshold(rho, n * l1_alpha) / (col_norm2[j] + n * l2_alpha)\n",
    "                r -= Xc[:, j] * w[j]\n",
    "            if np.max(np.abs(w - w_old)) < 1e-9:\n",
    "                break\n",
    "        self.coef_ = w\n",
    "        self.intercept_ = float(y_mean - x_mean @ w) if self.fit_intercept else 0.0\n",
    "        return self\n",
    "\n",
    "    def fit(self, X, y):\n",
    "        X = np.asarray(X, dtype=float)\n",
    "        y = np.asarray(y, dtype=float)\n",
    "        self._validate_params(X, y)\n",
    "        n, d = X.shape\n",
    "        self.loss_history_ = []\n",
    "        self.opt_success_ = True\n",
    "\n",
    "        if self.method == 'analytic' and self.penalty in (None, 'l2'):\n",
    "            Xa = np.column_stack([np.ones(n), X]) if self.fit_intercept else X\n",
    "            if self.penalty == 'l2' and self.lam > 0:\n",
    "                reg = np.sqrt(n * self.lam) * np.eye(d)\n",
    "                if self.fit_intercept:\n",
    "                    reg = np.column_stack([np.zeros(d), reg])\n",
    "                Xa = np.vstack([Xa, reg])\n",
    "                ya = np.concatenate([y, np.zeros(d)])\n",
    "            else:\n",
    "                ya = y\n",
    "            theta = np.linalg.lstsq(Xa, ya, rcond=None)[0]\n",
    "            if self.fit_intercept:\n",
    "                self.intercept_ = float(theta[0])\n",
    "                self.coef_ = theta[1:]\n",
    "            else:\n",
    "                self.intercept_ = 0.0\n",
    "                self.coef_ = theta\n",
    "            return self\n",
    "\n",
    "        if self.method == 'analytic' and self.penalty == 'l1':\n",
    "            return self._fit_coordinate_descent(X, y, self.lam, 0.0)\n",
    "\n",
    "        if self.method == 'analytic' and self.penalty == 'elasticnet':\n",
    "            return self._fit_coordinate_descent(X, y, self.lam * self.l1_ratio, self.lam * (1.0 - self.l1_ratio))\n",
    "\n",
    "        if self.method == 'analytic' and self.penalty == 'lp':\n",
    "            x_mean = X.mean(axis=0) if self.fit_intercept else np.zeros(d)\n",
    "            y_mean = y.mean() if self.fit_intercept else 0.0\n",
    "            Xc = X - x_mean\n",
    "            yc = y - y_mean\n",
    "            def loss_fn(w):\n",
    "                err = Xc @ w - yc\n",
    "                return 0.5 * float(np.mean(err ** 2)) + self.lam * float(np.sum((w ** 2 + 1e-6) ** (self.p / 2.0)))\n",
    "            res = minimize(loss_fn, np.zeros(d), method='BFGS', options={'gtol': 1e-4, 'maxiter': 2000})\n",
    "            self.opt_success_ = bool(res.success)\n",
    "            if not self.opt_success_:\n",
    "                raise RuntimeError(f'Оптимизатор не сошёлся для Lp (p={self.p}): {res.message}')\n",
    "            self.coef_ = res.x\n",
    "            self.intercept_ = float(y_mean - x_mean @ self.coef_) if self.fit_intercept else 0.0\n",
    "            return self\n",
    "\n",
    "        w = np.zeros(d)\n",
    "        b = 0.0\n",
    "        rng = np.random.default_rng(self.seed)\n",
    "        prev_loss = None\n",
    "        l1_strength = self.lam if self.penalty=='l1' else self.lam*self.l1_ratio if self.penalty=='elasticnet' else 0.0\n",
    "\n",
    "        if self.method == 'gd':\n",
    "            for _ in range(self.n_iter):\n",
    "                err = X @ w + b - y\n",
    "                curr_loss = 0.5 * float(np.mean(err ** 2)) + self._penalty_value(w)\n",
    "                if not np.isfinite(curr_loss):\n",
    "                    raise FloatingPointError('Расходимость в GD: потеря стала нечисловой')\n",
    "                self.loss_history_.append(curr_loss)\n",
    "                if prev_loss is not None and abs(prev_loss - curr_loss) < self.tol:\n",
    "                    break\n",
    "                prev_loss = curr_loss\n",
    "                grad_w = (1.0 / n) * (X.T @ err) + self._grad_penalty(w)\n",
    "                grad_w -= l1_strength*np.sign(w)\n",
    "                grad_b = (1.0 / n) * np.sum(err) if self.fit_intercept else 0.0\n",
    "                if not (np.isfinite(grad_w).all() and np.isfinite(grad_b)):\n",
    "                    raise FloatingPointError('Расходимость в GD: бесконечный градиент')\n",
    "                w -= self.lr * grad_w\n",
    "                if l1_strength:\n",
    "                    w = self._soft_threshold(w,self.lr*l1_strength)\n",
    "                b -= self.lr * grad_b\n",
    "        elif self.method == 'sgd':\n",
    "            step_count = 0\n",
    "            for _ in range(self.n_iter):\n",
    "                perm = rng.permutation(n)\n",
    "                for start in range(0, n, self.batch_size):\n",
    "                    idx = perm[start:start + self.batch_size]\n",
    "                    Xb, yb = X[idx], y[idx]\n",
    "                    err = Xb @ w + b - yb\n",
    "                    step_count += 1\n",
    "                    step = self.lr / (1.0 + 1e-3 * step_count)\n",
    "                    grad_w = (1.0 / len(idx)) * (Xb.T @ err) + self._grad_penalty(w)\n",
    "                    grad_w -= l1_strength*np.sign(w)\n",
    "                    grad_b = (1.0 / len(idx)) * np.sum(err) if self.fit_intercept else 0.0\n",
    "                    if not (np.isfinite(grad_w).all() and np.isfinite(grad_b)):\n",
    "                        raise FloatingPointError('Расходимость в SGD: бесконечный градиент')\n",
    "                    w -= step * grad_w\n",
    "                    if l1_strength:\n",
    "                        w = self._soft_threshold(w,step*l1_strength)\n",
    "                    b -= step * grad_b\n",
    "                full_err = X @ w + b - y\n",
    "                curr_loss = 0.5 * float(np.mean(full_err ** 2)) + self._penalty_value(w)\n",
    "                if not np.isfinite(curr_loss):\n",
    "                    raise FloatingPointError('Расходимость в SGD: потеря стала нечисловой')\n",
    "                self.loss_history_.append(curr_loss)\n",
    "                if prev_loss is not None and abs(prev_loss - curr_loss) < self.tol:\n",
    "                    break\n",
    "                prev_loss = curr_loss\n",
    "\n",
    "        if not (np.isfinite(w).all() and np.isfinite(b)):\n",
    "            raise FloatingPointError('Веса модели содержат NaN или Inf')\n",
    "        self.coef_ = w\n",
    "        self.intercept_ = float(b)\n",
    "        return self\n",
    "\n",
    "    def predict(self, X):\n",
    "        X = np.asarray(X, dtype=float)\n",
    "        if not np.isfinite(X).all():\n",
    "            raise ValueError('Признаки для predict содержат NaN или Inf')\n",
    "        return X @ self.coef_ + self.intercept_\n",
    "\n",
    "\n",
    "def split_indices(n, test_size=0.2, seed=SEED):\n",
    "    perm = np.random.default_rng(seed).permutation(n)\n",
    "    cut = int(round(n * (1.0 - test_size)))\n",
    "    return perm[:cut], perm[cut:]\n",
    "\n",
    "\n",
    "def kfold_splits(n, k=5, shuffle=True, seed=SEED):\n",
    "    if not isinstance(k,(int,np.integer)) or not 2<=k<=n:\n",
    "        raise ValueError('Нужно целое k: 2 <= k <= n')\n",
    "    idx = np.random.default_rng(seed).permutation(n) if shuffle else np.arange(n)\n",
    "    folds = np.array_split(idx, k)\n",
    "    for i in range(k):\n",
    "        val_idx = folds[i]\n",
    "        tr_idx = np.concatenate([folds[j] for j in range(k) if j != i])\n",
    "        yield tr_idx, val_idx\n",
    "\n",
    "\n",
    "def leave_one_out_splits(n):\n",
    "    idx = np.arange(n)\n",
    "    for i in range(n):\n",
    "        yield np.delete(idx, i), np.array([i])"
   ]
