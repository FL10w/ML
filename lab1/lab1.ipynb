    "final_model = ScorecardMixtureRegression(age_knots=selected_age_knots, lam_index=selected_lam_index).fit(train, y_all)\n",
    "test_pred = final_model.predict(test)\n",
    "assert test_pred.shape == (len(test),) and np.isfinite(test_pred).all()\n",
    "submission = pd.DataFrame({'ID': test['ID'].to_numpy(), TARGET: test_pred})\n",
    "assert list(submission.columns) == list(sample.columns) == ['ID', TARGET]\n",
    "assert submission.shape == sample.shape and submission['ID'].equals(sample['ID'])\n",
    "assert submission['ID'].is_unique and not submission.isna().any().any()\n",
    "sub_path = OUT_DIR / 'submission.csv'\n",
    "same = False\n",
    "if sub_path.exists():\n",
    "    previous = pd.read_csv(sub_path)\n",
    "    same = (previous.shape == submission.shape and list(previous.columns) == list(submission.columns)\n",
    "            and previous['ID'].equals(submission['ID'])\n",
    "            and np.allclose(previous[TARGET], test_pred, atol=1e-10, rtol=0))\n",
    "if not same:\n",
    "    submission.to_csv(sub_path, index=False)\n",
    "saved = pd.read_csv(sub_path)\n",
    "assert saved['ID'].equals(test['ID']) and saved.shape == (len(test), 2)\n",
    "assert np.isfinite(saved[TARGET]).all() and not saved.isna().any().any()\n",
    "assert np.allclose(saved[TARGET], test_pred, atol=1e-10, rtol=0)\n",
    "\n",
    "fig, axis = plt.subplots(figsize=(10, 3.8))\n",
    "bins = np.linspace(min(oof_final.min(), test_pred.min()), max(oof_final.max(), test_pred.max()), 45)\n",
    "axis.hist(oof_final, bins=bins, density=True, color='#a64b32', alpha=0.3, label='OOF, обучение')\n",
    "axis.hist(test_pred, bins=bins, density=True, histtype='step', color='#386657', linewidth=1.8, label='Тестовая таблица')\n",
    "axis.set(title='Сравнение распределений прогноза', xlabel='RiskScore', ylabel='Плотность')\n",
    "axis.legend(frameon=False)\n",
    "fig.tight_layout()\n",
    "plt.show()\n",
