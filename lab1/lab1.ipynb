   "source": [
    "train_raw = pd.read_csv(DATA_DIR / 'train.csv')\n",
    "test = pd.read_csv(DATA_DIR / 'test.csv')\n",
    "sample = pd.read_csv(DATA_DIR / 'ex.csv')\n",
    "\n",
    "assert [c for c in train_raw.columns if c != TARGET] == [c for c in test.columns if c != 'ID']\n",
    "assert test['ID'].equals(sample['ID'])\n",
    "\n",
    "print(f'train_raw: {train_raw.shape}, test: {test.shape}, ex: {sample.shape}')\n",
    "print('Признаки train/test и ID test/ex совпадают.')\n",
    "\n",
    "overview = pd.DataFrame({\n",
    "    'dtype': train_raw.dtypes.astype(str),\n",
    "    'missing_train': train_raw.isna().sum(),\n",
    "    'missing_test': test.isna().sum().reindex(train_raw.columns).fillna(0).astype(int),\n",
    "    'nunique_train': train_raw.nunique(),\n",
    "})\n",
    "print(overview.to_string())\n",
    "\n",
    "empty_rows = int(train_raw.isna().all(axis=1).sum())\n",
    "dup_rows = int(train_raw.dropna(how='all').duplicated().sum())\n",
    "outlier_rows = int((~train_raw[TARGET].dropna().between(0, 100)).sum())\n",
    "print(f'Пустых строк: {empty_rows} | дубликатов: {dup_rows} | выбросов RiskScore: {outlier_rows}')\n",
    "print('Пропусков в test:', int(test.isna().sum().sum()), '| дубликатов в test:', int(test.duplicated().sum()))\n",
    "\n",
    "def clean_train(df):\n",
    "    out = df.dropna(how='all').drop_duplicates()\n",
    "    out = out[out[TARGET].between(0, 100)]\n",
    "    return out.dropna().reset_index(drop=True)\n",
    "\n",
    "train = clean_train(train_raw)\n",
    "y_all = train[TARGET].to_numpy(dtype=float)\n",
    "\n",
    "CAT_COLS = ['EmploymentStatus', 'EducationLevel', 'MaritalStatus', 'HomeOwnershipStatus', 'LoanPurpose']\n",
    "NUM_COLS = [c for c in train.select_dtypes(include=np.number).columns if c != TARGET]\n",
    "\n",
    "print(f'После очистки train: {train.shape}, RiskScore min={y_all.min():.2f}, max={y_all.max():.2f}, mean={y_all.mean():.2f}')\n",
    "print(train[NUM_COLS + [TARGET]].describe().T[['count', 'mean', 'std', 'min', '50%', 'max']].round(2).to_string())\n",
    "dates = pd.to_datetime(train['ApplicationDate'],errors='raise')\n",
    "year = dates.dt.year\n",
    "print(f'Даты заявок: {dates.min().date()} — {dates.max().date()}, уникальных дат: {dates.nunique()}')\n",
    "print('Корреляция года заявки с RiskScore:',round(float(year.corr(train[TARGET])),4))\n",
    "print('Доля строк с MonthlyIncome = AnnualIncome / 12:',\n",
    "      round(float(np.isclose(train.MonthlyIncome,train.AnnualIncome/12).mean()),4))"
   ]
