   "source": [
    "def loo_predictions_ols(X,y):\n",
    "    a = np.column_stack([np.ones(len(X)),X])\n",
    "    u,s,_ = np.linalg.svd(a,full_matrices=False)\n",
    "    cutoff = np.finfo(float).eps*max(a.shape)*s[0]\n",
    "    keep = s>cutoff\n",
    "    u = u[:,keep]\n",
    "    leverage = np.sum(u*u,axis=1)\n",
    "    if np.min(1-leverage)<=1e-8:\n",
    "        raise ValueError('LOO-формула неприменима: удаление строки может менять ранг')\n",
    "    residual = y-u@(u.T@y)\n",
    "    return y-residual/(1-leverage),int(keep.sum()),leverage\n",
    "\n",
    "sub_n = 400\n",
    "frame_tr = train.iloc[tr_idx].reset_index(drop=True)\n",
    "frame_sub = frame_tr.iloc[:sub_n]\n",
    "for frame in [frame_tr,frame_sub]:\n",
    "    assert all(frame[c].value_counts().min()>1 for c in CAT_COLS)\n",
    "X_sub,y_sub = X_tr[:sub_n],y_tr[:sub_n]\n",
    "oof_sub_mine,oof_sub_sk = np.zeros(sub_n),np.zeros(sub_n)\n",
    "for tr_i,va_i in leave_one_out_splits(sub_n):\n",
    "    enc = BaselineEncoder().fit(frame_sub.iloc[tr_i])\n",
    "    raw_tr,raw_va = enc.transform(frame_sub.iloc[tr_i]),enc.transform(frame_sub.iloc[va_i])\n",
    "    sc = ZScoreScaler().fit(raw_tr)\n",
    "    xx_tr,xx_va = sc.transform(raw_tr),sc.transform(raw_va)\n",
    "    oof_sub_mine[va_i] = LinearRegression().fit(xx_tr,y_sub[tr_i]).predict(xx_va)\n",
    "    oof_sub_sk[va_i] = SkLinearRegression().fit(xx_tr,y_sub[tr_i]).predict(xx_va)\n",
    "oof_sub_fast,rank_sub,h_sub = loo_predictions_ols(X_sub,y_sub)\n",
    "assert np.allclose(oof_sub_mine,oof_sub_sk,atol=1e-7,rtol=0)\n",
    "assert np.allclose(oof_sub_mine,oof_sub_fast,atol=1e-7,rtol=0)\n",
    "print(f'LOO на {sub_n} строках: max разница со sklearn {np.max(np.abs(oof_sub_mine-oof_sub_sk)):.2e}; '\n",
    "      f'с формулой SVD {np.max(np.abs(oof_sub_mine-oof_sub_fast)):.2e}')\n",
    "oof_full_loo,rank_full,h_full = loo_predictions_ols(X_tr,y_tr)\n",
    "print(f'Полный LOO: n={len(y_tr)}, ранг={rank_full}/{X_tr.shape[1]+1}, min(1-h)={np.min(1-h_full):.4f}')\n",
    "print('Метрики по всему OOF-вектору:',{k:round(v,4) for k,v in all_metrics(y_tr,oof_full_loo).items()})"
   ]
  },
