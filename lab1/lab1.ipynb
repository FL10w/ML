    "sk_z = SkStandardScaler().fit(X_num[tr_demo])\n",
    "mm_scaler = MinMaxNormalizer().fit(X_num[tr_demo])\n",
    "mm_tr, mm_va = mm_scaler.transform(X_num[tr_demo]), mm_scaler.transform(X_num[va_demo])\n",
    "sk_mm = SkMinMaxScaler().fit(X_num[tr_demo])\n",
